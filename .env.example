# ==============================================================================
# WhatsApp AI Agent (NextGen) - Environment Configuration
# ==============================================================================

# 1. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
# Get your permanent system user access token from:
# https://business.facebook.com/settings/system-users
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_token_here

# From Meta App Dashboard > WhatsApp > API Setup > Phone Number ID:
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Secret verification token for the webhook handshake (Meta GET /api/webhook):
WHATSAPP_VERIFY_TOKEN=whatsapp_agent_verify_token_123

# 2. AI Intelligence Providers (Choose OpenRouter, Groq, or OpenAI)
# ------------------------------------------------------------------------------
# Provider choice: "openrouter" | "groq" | "openai"
AI_PROVIDER=openrouter

# OpenRouter (Recommended for Claude 3.5 Sonnet, GPT-4o, DeepSeek-V3):
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=anthropic/claude-sonnet-4-20250514

# OR use Groq for ultra-fast response times (~500 tokens/sec):
# GROQ_API_KEY=gsk_your_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# OR use OpenAI direct:
# OPENAI_API_KEY=sk-your_openai_key_here
# AI_MODEL=gpt-4o

# 3. Storage & Database (Optional - Zero Setup Local Mode runs automatically!)
# ------------------------------------------------------------------------------
# When left blank or commented out, the agent runs automatically with
# the embedded local persistent database in .data/whatsapp_agent.json!
# To connect your cloud PostgreSQL / Supabase database:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. App URL (for webhooks & local preview)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
